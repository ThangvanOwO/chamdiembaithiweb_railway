# Copy to .env.vps on the VPS. Never commit .env.vps.
# Generate the two secrets with: openssl rand -hex 32 / openssl rand -hex 48
POSTGRES_DB=gradeflow
POSTGRES_USER=gradeflow
POSTGRES_PASSWORD=replace_with_64_hex_characters
DJANGO_SECRET_KEY=replace_with_96_hex_characters

DJANGO_DEBUG=False
ALLOWED_HOSTS=gradeflow.io.vn,vps-test.gradeflow.io.vn
CSRF_TRUSTED_ORIGINS=https://gradeflow.io.vn,https://vps-test.gradeflow.io.vn
PUBLIC_SITE_URL=https://gradeflow.io.vn
RAILWAY_PUBLIC_DOMAIN=gradeflow.io.vn
TRUST_PROXY_CLIENT_IP=1

# Google OAuth web client. Add values only in the untracked .env.vps file.
# Authorized redirect URI: https://gradeflow.io.vn/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

HYBRID_CNN_ENABLE=1
LIVE_SINGLE_PASS_GRADING=1

# Keep public email registration closed until real SMTP and Turnstile values
# have been configured. Do not paste secret values into source control.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rewarded credits remain disabled until AdMob SSV is configured and tested.
ADMOB_SSV_ENABLED=0
